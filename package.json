{
    "name": "eslint-config-futagozaryuu",
    "private": true,
    "workspaces": [
        "packages/@futagoza/*"
    ],
    "scripts": {
        "rebuild.all (preview)": "node scripts/rebuild.all.js -t",
        "rebuild.all": "node scripts/rebuild.all.js",
        "test": "eslint .",
        "fix": "eslint . --fix",
        "preview": "npx @eslint/config-inspector@latest",
        "bump-dry": "bump-updated --debug --dry",
        "bump": "bump-updated",
        "bump:major": "bump-updated -v major",
        "bump:minor": "bump-updated -v minor",
        "bump:patch": "bump-updated -v patch",
        "rebuild.core (preview)": "node scripts/rebuild.core.js -t",
        "rebuild.core": "node scripts/rebuild.core.js",
        "rebuild.n (preview)": "node scripts/rebuild.n.js -t",
        "rebuild.n": "node scripts/rebuild.n.js",
        "rebuild.style (preview)": "node scripts/rebuild.style.js -t",
        "rebuild.style": "node scripts/rebuild.style.js",
        "rebuild.ts (preview)": "node scripts/rebuild.ts.js -t",
        "rebuild.ts": "node scripts/rebuild.ts.js"
    },
    "devDependencies": {
        "@futagoza/cli-utils": "1.5.1",
        "@eslint-stylistic/metadata":"6.0.0-beta.5",
        "bump-updated": "4.0.4",
        "dedent": "1.7.2",
        "eslint": "10.9.0",
        "typescript": "6.0.3"
    },
    "type": "module",
    "engines": {
        "node": ">=20.0.0"
    }
}
