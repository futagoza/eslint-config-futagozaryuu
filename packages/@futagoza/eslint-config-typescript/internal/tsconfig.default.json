{
    "$schema": "https://json.schemastore.org/tsconfig",
    "exclude": [
        "dist",
        "node_modules",
        "out",
        "temp"
    ],
    "include": [
        "__CWD__**/*.cts",
        "__CWD__**/*.mts",
        "__CWD__**/*.ts",
        "__CWD__**/*.tsx"
    ],
    "compilerOptions": {
        "disableSizeLimit": true,
        "noEmit": true,
        "rootDir": "__CWD__",
        "strict": false,
        "strictNullChecks": true,
        "suppressImplicitAnyIndexErrors": true
    }
}
